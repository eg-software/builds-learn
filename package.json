{
  "name": "builds-learn-js-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "Simple Express service to exercise GitHub Actions.",
  "main": "src/server.js",
  "scripts": {
    "build": "node -e \"console.log('Build completed')\"",
    "lint": "eslint .",
    "lint:report": "eslint . -f html -o reports/eslint/eslint-report.html",
    "start": "node src/server.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage"
  },
  "dependencies": {
    "express": "^4.18.3"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "eslint-formatter-html": "^2.7.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
